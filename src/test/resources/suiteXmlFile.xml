<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="FullTests"
       parallel="tests"
       thread-count="4"
       configfailurepolicy="continue">

    <parameter name="env" value="staging"/>
    <parameter name="browser" value="chrome"/>

    <listeners>
        <listener class-name="testng.TestListener"/>
    </listeners>

    <test name="SmokeTestBlock" preserve-order="true">
        <parameter name="browser" value="firefox"/>

        <groups>
            <run>
                <include name="smoke"/>
                <exclude name="broken"/>
            </run>
        </groups>

        <classes>
            <class name="testng.TestngTest">
                <methods>
                    <include name="validLogin"/>
                    <exclude name="loginWithEmptyPassword"/>
                </methods>
            </class>

            <class name="testng.TestNGExampleTest"/>
        </classes>
    </test>

    <test name="RegressionTestBlock">
        <parameter name="browser" value="edge"/>

        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>

        <classes>
            <class name="testng.TestNgExampleTest1"/>
            <class name="testng.TestNGExampleTest3"/>
        </classes>
    </test>

</suite>
